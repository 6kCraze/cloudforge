# Local development only. Copy this file to .env.
POSTGRES_DB=cloudforge
POSTGRES_USER=cloudforge
POSTGRES_PASSWORD=cloudforge_dev_only
POSTGRES_PORT=5432

APP_ENV=development
# Go runs on the Windows host in V0, so use localhost and the published port.
DATABASE_URL=postgres://cloudforge:cloudforge_dev_only@localhost:5432/cloudforge?sslmode=disable

