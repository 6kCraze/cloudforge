# Local development only. Copy this file to .env.
POSTGRES_DB=cloudforge
POSTGRES_USER=cloudforge
POSTGRES_PASSWORD=cloudforge_dev_only
POSTGRES_PORT=5432

# Local RabbitMQ development credentials. Use separate secrets outside local development.
RABBITMQ_DEFAULT_USER=cloudforge
RABBITMQ_DEFAULT_PASS=cloudforge_dev_only
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
# Go processes run on the Windows host and connect through the published AMQP port.
RABBITMQ_URL=amqp://cloudforge:cloudforge_dev_only@localhost:5672/

APP_ENV=development
# Go runs on the Windows host, so use localhost and the published port.
DATABASE_URL=postgres://cloudforge:cloudforge_dev_only@localhost:5432/cloudforge?sslmode=disable
HTTP_PORT=8080
# Absolute path shared by API and workers. Blank uses the user's cache directory
# followed by CloudForge/storage (normally %LOCALAPPDATA%\CloudForge\storage).
STORAGE_ROOT=
# Optional. If blank, the worker uses hostname-processID.
WORKER_ID=
WORKER_BACKOFF_MIN=250ms
WORKER_BACKOFF_MAX=5s
DISPATCHER_POLL_INTERVAL=500ms
DISPATCHER_CONFIRM_TIMEOUT=5s
DISPATCHER_BACKOFF_MIN=250ms
DISPATCHER_BACKOFF_MAX=5s
